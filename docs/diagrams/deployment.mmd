flowchart TB
  subgraph local["LOCAL COMPUTER"]
    source["FLUJO source workspace<br/>Flows · models · conversations · userdata<br/>MCP configuration + supported credentials"]
    discovery["Native launch registration<br/>Private ~/.flujo/instances<br/>Fresh HMAC challenge before bearer use"]
    bridge["flujo-cloud CLI + ManagedCloud<br/>sources · workspaces · preflight<br/>up · call · list · down"]
    storage["Private ~/.flujo-cloud<br/>Worker credentials · attempt identities<br/>Journals + operation locks"]
    source --> discovery --> bridge
    bridge --- storage
    source -->|"Authenticated workspace capture"| bridge
  end

  registry["OFFICIAL GHCR WORKER IMAGE<br/>cloud-worker revision / version / channel<br/>Check source compatibility + image identity<br/>Pin verified Linux manifest digest"]
  bootstrap["PROVISION EACH WORKER<br/>Fly API + existing flyctl login<br/>Create app, Machine and volume<br/>Snapshot key + worker bearer via Fly secrets<br/>AES-GCM encrypted snapshot via SFTP"]
  calls["RUN SELECTED FLOWS<br/>Authenticated private Fly tunnels"]

  subgraph fleet["PRIVATE FLY NETWORK · NO PUBLIC SERVICES"]
    direction LR
    w1["APP 1 · MACHINE 1<br/>FLUJO execution engine<br/>Codex + MCP runtimes<br/>Own persistent workspace volume"]
    w2["APP 2 · MACHINE 2<br/>FLUJO execution engine<br/>Codex + MCP runtimes<br/>Own persistent workspace volume"]
    w3["APP 3 · MACHINE 3<br/>FLUJO execution engine<br/>Codex + MCP runtimes<br/>Own persistent workspace volume"]
  end

  services["EXTERNAL SERVICES<br/>Codex / model provider · GitHub API<br/>Other configured MCP services"]

  bridge -.-> registry -.-> bootstrap
  bridge -.-> bootstrap
  bootstrap -.->|"Restore state, reinstall MCP packages, verify readiness"| fleet
  bridge ==> calls ==> fleet
  fleet -->|"Outbound model requests and MCP calls"| services

  classDef control fill:#e9f1ff,stroke:#3169a5,color:#15375b
  classDef worker fill:#e6f5ef,stroke:#34806a,color:#194d3e
  classDef external fill:#fff4df,stroke:#ac7c2b,color:#684612
  class source,discovery,bridge,storage,registry,bootstrap,calls control
  class w1,w2,w3 worker
  class services external
